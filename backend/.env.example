PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
VENOM_API_KEY=replace-with-a-strong-random-key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_INMEMORY_DB=true
INMEMORY_DB_NAME=venom_dev
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
CLAUDE_API_KEY=replace-with-your-anthropic-key
CLAUDE_MODEL=claude-3-5-sonnet-latest
CLAUDE_LEARNER_MODEL=claude-3-5-sonnet-latest
CLAUDE_PLANNER_STRICT=false
ENABLE_CLAUDE_CVE_TAGGING=true
CLAUDE_TAGGER_MODEL=claude-3-5-haiku-latest
CLAUDE_JSON_REPAIR_MODEL=claude-3-5-sonnet-latest
ENABLE_DOCKER_TOOLS=false
VENOM_MONTHLY_BUDGET_USD=400
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_SYNC_LIMIT=25
NVD_SYNC_DAYS=7
NVD_REQUEST_TIMEOUT_MS=15000
ENABLE_CVE_SYNC_JOB=false
NVD_PAGE_SIZE=100
NVD_NO_KEY_DELAY_MS=6000
CVE_SYNC_CRON=0 2 * * *
CVE_SYNC_TIMEZONE=UTC
CVE_SYNC_ON_STARTUP=true
CVE_SYNC_STARTUP_DELAY_MS=10000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
